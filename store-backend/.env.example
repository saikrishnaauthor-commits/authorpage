# Google Sheet that holds all store data (Orders, Sales, Books, Prices tabs).
# It is the long ID in the Sheet's URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEETS_ID=

# Service account JSON (one line). The same account reads the private e-book
# files in Drive. Share the Sheet with its client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Drive folder for cover images uploaded from admin.html (optional).
GOOGLE_DRIVE_IMAGES_FOLDER_ID=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin page login token, and the secret used to sign e-book reader sessions.
ADMIN_TOKEN=
SESSION_SECRET=

# Order confirmation emails
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Only for the one-time `npm run migrate` from the old MongoDB database.
MONGO_URI=
