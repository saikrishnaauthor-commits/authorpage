# Set these in Render Environment settings; never commit real values.
MONGO_URI=your_mongodb_atlas_connection_string
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
ADMIN_TOKEN=generate_a_long_random_admin_token
SESSION_SECRET=generate_a_separate_long_random_session_secret
SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM=Your Store <you@example.com>
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}
GOOGLE_DRIVE_IMAGES_FOLDER_ID=your_drive_folder_id
